# Dependencies
node_modules/

# WhatsApp session credentials (RNF4 - never commit)
.wwebjs_auth/
.wwebjs_cache/

# Runtime mutable state (auto-recreated on boot; may contain personal schedules)
# Decision: state.json is ephemeral timer bookkeeping with zero information value
# in git, so it is ignored. data/tasks.json IS committed (initial empty schema).
data/state.json
data/state.json.tmp

# Environment / logs
.env
npm-debug.log*

# OS / tooling noise
desktop.ini
.atl/
