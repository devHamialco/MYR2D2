# R2D2 environment configuration
# Copy this file to .env and adjust values as needed. The COPY (.env) is
# gitignored; this example file itself is tracked on purpose.

# Chat that R2D2 listens to. Use "me" for a self-chat, or a full JID like
# 521xxxxxxxxxx@c.us
TARGET_CHAT_ID=me

# Skip Chromium download during npm install (optional; set false to let
# puppeteer fetch its own Chromium for whatsapp-web.js runtime)
PUPPETEER_SKIP_DOWNLOAD=true

# Optional overrides (defaults shown)
# HYDRATION_CRON=30 6 * * *
# POMODORO_WORK_MS=1500000
# POMODORO_SHORT_BREAK_MS=300000
# POMODORO_LONG_BREAK_MS=900000
# TASKS_CRON=*/30 8-22 * * *
# TASKS_TIME_FROM=08:00
# TASKS_TIME_TO=22:00
# TASKS_SEND_PROBABILITY=0.3
# DATA_DIR=./data
